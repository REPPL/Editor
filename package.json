{
  "name": "editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A lightweight Markdown editor for notes and presentations.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit && npm run lint:rust",
    "lint:rust": "cargo audit --file src-tauri/Cargo.lock",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@replit/codemirror-emacs": "6.1.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "markdown-it": "14.3.1",
    "markdown-it-attrs": "4.5.0",
    "markdown-it-bracketed-spans": "1.0.3",
    "markdown-it-footnote": "4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-attrs": "4.1.3",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "reveal.js": "5.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
